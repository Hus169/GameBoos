<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="6.0dip"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        android:id="@id/iv_member_image"
        android:background="@color/hpp_main_tile_background"
        android:layout_width="104.0dip"
        android:layout_height="104.0dip"
        android:src="@mipmap/ic_launcher"
        android:scaleType="fitXY"
        android:contentDescription="Member Image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cl_member_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/cl_member_text"
        android:layout_width="0.0dip"
        android:layout_height="0.0dip"
        android:layout_marginStart="14.0dip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_member_image"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@id/tv_member_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HoneyPlayPlus.TextAppearance.CreditName" />
        <TextView
            android:id="@id/tv_member_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.0dip"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_member_name"
            style="@style/HoneyPlayPlus.TextAppearance.CreditComment" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>