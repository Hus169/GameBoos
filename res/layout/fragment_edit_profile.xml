<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@id/app_bar"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        style="@style/HoneyPlayPlus.Style.Appbar">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@id/collapsing_app_bar"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:elevation="0.0dip"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            style="@style/HoneyPlayPlus.Style.CollapsingToolbar">
            <androidx.appcompat.widget.Toolbar
                android:theme="@style/HoneyPlayPlus.Style.Toolbar"
                android:layout_gravity="bottom"
                android:id="@id/toolbar"
                android:layout_width="fill_parent"
                android:layout_height="?android:actionBarSize"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <FrameLayout
        android:id="@id/fl_content_frame"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.core.widget.NestedScrollView
            android:layout_width="fill_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@id/cl_container"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/empty_space_width">
                <TextView
                    android:id="@id/tv_current_profile"
                    android:paddingTop="13.0dip"
                    android:paddingBottom="5.0dip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_profile"
                    android:fontFamily="@style/HoneyPlayPlus.TextAppearance.Subheader"
                    android:paddingStart="18.0dip"
                    android:paddingEnd="18.0dip"
                    android:layout_marginHorizontal="10.0dip"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/cl_header"
                    android:background="@color/hpp_main_tile_background"
                    android:layout_width="fill_parent"
                    android:layout_height="56.0dip"
                    android:layout_marginTop="4.0dip"
                    android:layout_marginHorizontal="10.0dip"
                    android:paddingHorizontal="8.0dip"
                    app:layout_constraintTop_toBottomOf="@id/tv_current_profile">
                    <ImageView
                        android:id="@id/iv_profile_icon"
                        android:layout_width="36.0dip"
                        android:layout_height="36.0dip"
                        android:contentDescription="Profile icon"
                        android:layout_marginStart="18.0dip"
                        android:layout_marginVertical="10.0dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <TextView
                        android:id="@id/tv_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10.0dip"
                        android:layout_marginVertical="16.5dip"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_profile_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        style="@style/HoneyPlayPlus.TextAppearance.List_MainText" />
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@id/cl_content"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16.0dip"
                    app:layout_constraintTop_toBottomOf="@id/cl_header">
                    <TextView
                        android:id="@id/tv_rempapping_key_title"
                        android:paddingTop="13.0dip"
                        android:paddingBottom="5.0dip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/edit_buttons"
                        android:fontFamily="@style/HoneyPlayPlus.TextAppearance.Subheader"
                        android:paddingStart="18.0dip"
                        android:paddingEnd="18.0dip"
                        android:layout_marginHorizontal="10.0dip"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@id/rv_edit_buttons"
                        android:background="@color/hpp_main_tile_background"
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4.0dip"
                        android:layout_marginHorizontal="10.0dip"
                        android:paddingHorizontal="8.0dip"
                        app:layout_constraintTop_toBottomOf="@id/tv_rempapping_key_title" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>