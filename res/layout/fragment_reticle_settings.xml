<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    style="@style/HoneyPlayPlus.Theme.AppCompat.HoneyPlayPlus.DefaultFragment"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout
        android:id="@id/app_bar"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        app:expanded="false"
        style="@style/HoneyPlayPlus.Style.Appbar">
        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@id/collapsing_app_bar"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:title="@string/title_reticle_settings"
            style="@style/HoneyPlayPlus.Style.CollapsingToolbar">
            <androidx.appcompat.widget.Toolbar
                android:theme="@style/HoneyPlayPlus.Style.Toolbar"
                android:layout_gravity="bottom"
                android:id="@id/toolbar"
                android:layout_width="fill_parent"
                android:layout_height="?android:actionBarSize"
                app:layout_collapseMode="pin" />
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:baselineAligned="false"
        android:weightSum="2.0"
        android:layout_marginHorizontal="@dimen/empty_space_width"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <androidx.core.widget.NestedScrollView
            android:id="@id/nsv_reticle_preview"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:fillViewport="true"
            android:layout_weight="1.0">
            <include
                android:id="@id/include_reticle_preview"
                layout="@layout/layout_reticle_preview" />
        </androidx.core.widget.NestedScrollView>
        <androidx.core.widget.NestedScrollView
            android:id="@id/nsv_reticle_settings"
            android:layout_width="fill_parent"
            android:layout_height="0.0dip"
            android:layout_marginTop="@dimen/empty_space_height_wide"
            android:fillViewport="true"
            android:layout_weight="1.0">
            <include
                android:id="@id/include_reticle_settings"
                layout="@layout/layout_reticle_settings" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>