<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@id/cl_reticle_preview"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@id/cl_auto_change_container"
        android:background="@color/hpp_main_tile_background"
        android:clickable="true"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/ripple_list_selector"
        android:minHeight="@dimen/list_min_height"
        android:paddingHorizontal="@dimen/list_padding_width"
        android:paddingVertical="@dimen/list_padding_height"
        app:layout_constraintBottom_toTopOf="@id/fl_reticle_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:id="@id/tv_auto_change_label"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_auto_change"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/HoneyPlayPlus.TextAppearance.Title" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@id/switch_auto_change"
            android:layout_width="wrap_content"
            android:layout_height="20.0dip"
            android:checked="true"
            android:layout_marginEnd="4.0dip"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <FrameLayout
        android:id="@id/fl_reticle_preview"
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginTop="16.0dip"
        app:layout_constraintBottom_toTopOf="@id/btn_fullscreen_preview"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="@dimen/list_min_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_auto_change_container">
        <androidx.viewpager2.widget.ViewPager2
            android:id="@id/vp_background_images"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
        <com.samsung.android.game.honeyplayplus.aim.ui.ReticleOverlayView
            android:id="@id/aim_assist_view"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent" />
    </FrameLayout>
    <androidx.appcompat.widget.AppCompatButton
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@id/btn_fullscreen_preview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/empty_space_height_wide"
        android:foreground="@drawable/ripple_list_selector"
        android:minWidth="216.0dip"
        android:minHeight="@dimen/list_min_height"
        android:text="@string/btn_fullscreen_preview"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_reticle_preview"
        style="@style/HoneyPlayPlus.TextAppearance.Dialog_Button" />
</androidx.constraintlayout.widget.ConstraintLayout>