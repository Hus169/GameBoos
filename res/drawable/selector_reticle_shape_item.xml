<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/hpp_accent_color_alpha" />
            <stroke
                android:width="2.0dip"
                android:color="@color/hpp_accent_color" />
            <corners
                android:radius="12.0dip" />
        </shape>
    </item>
    <item
        android:state_pressed="true">
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/hpp_accent_color_alpha" />
            <corners
                android:radius="12.0dip" />
        </shape>
    </item>
    <item>
        <shape
            android:shape="rectangle">
            <solid
                android:color="@color/hpp_card_background" />
            <stroke
                android:width="1.0dip"
                android:color="@color/hpp_border_color" />
            <corners
                android:radius="12.0dip" />
        </shape>
    </item>
</selector>